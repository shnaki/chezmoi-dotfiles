# chezmoi のソース管理用ファイル（デプロイ対象ではない）
# .chezmoiignore のパターンは配置先パスに対する doublestar マッチで、gitignore と違い
# `/` をまたがない。サブディレクトリの README.md を無視するには ** が要る。
README.md
**/README.md

# Windows 以外では AppData 配下を配置しない
{{ if ne .chezmoi.os "windows" }}
AppData
{{ end }}

# Windows では GUI アプリの設定を AppData/Roaming 側に配置するため
# ~/.config 配下は丸ごと対象外にする
{{ if eq .chezmoi.os "windows" }}
.config
{{ end }}

# ~/.claude はランタイム生成物と認証情報が設定ファイルと同居しているため、
# 管理対象（settings.json / CLAUDE.md / output-styles / skills）以外は明示的に除外する
.claude/.credentials.json
.claude/.claude.json
.claude/settings.local.json
.claude/history.jsonl
.claude/projects
.claude/backups
.claude/plugins
.claude/file-history
.claude/shell-snapshots
.claude/tasks
.claude/plans
.claude/cache
.claude/sessions
.claude/session-env
.claude/daemon
.claude/scheduled-tasks
.claude/ship-issues
.claude/statsig
.claude/todos
.claude/ide
.claude/debug
.claude/downloads
.claude/paste-cache
.claude/*-cache.json
.claude/.last-*
.claude/*.bak
.claude/*.orig
