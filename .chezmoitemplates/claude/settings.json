{
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh label list:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh search prs:*)",
      "Bash(gh workflow list:*)",
      "Bash(git commit:*)",
      "Bash(sh ~/.claude/scripts/work-status.sh:*)"
    ],
    "deny": ["mcp__Claude_Browser"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Browser__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo Browser pane is disabled because it crashes the Claude Desktop GPU process. See anthropics/claude-code#82967. Start the dev server with run_in_background and verify with curl or tests. 1>&2 && exit 2"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "outputStyle": "ja-concise",
  "spinnerTipsEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
